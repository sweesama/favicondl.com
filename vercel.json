{
  "functions": {
    "api/extract.js": { "maxDuration": 20 },
    "api/favicon.js": { "maxDuration": 20 },
    "api/proxy.js": { "maxDuration": 20 }
  },
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/es/tamanos-de-favicon.html", "destination": "/es/tamanos-de-favicon.html", "permanent": true },
    { "source": "/blog/chrome-not-showing-favicons.html", "destination": "/blog/favicon-not-showing.html", "permanent": true },
    { "source": "/zh/blog/chrome-not-showing-favicons.html", "destination": "/zh/blog/favicon-not-showing.html", "permanent": true },
    { "source": "/ja/blog/chrome-not-showing-favicons.html", "destination": "/ja/blog/favicon-not-showing.html", "permanent": true },
    { "source": "/ko/blog/chrome-not-showing-favicons.html", "destination": "/ko/blog/favicon-not-showing.html", "permanent": true },
    { "source": "/es/blog/chrome-not-showing-favicons.html", "destination": "/es/blog/favicon-not-showing.html", "permanent": true }
  ],
  "rewrites": [
    { "source": "/zh", "destination": "/zh/index.html" },
    { "source": "/ja", "destination": "/ja/index.html" },
    { "source": "/ko", "destination": "/ko/index.html" },
    { "source": "/es", "destination": "/es/index.html" },
    { "source": "/zh/", "destination": "/zh/index.html" },
    { "source": "/ja/", "destination": "/ja/index.html" },
    { "source": "/ko/", "destination": "/ko/index.html" },
    { "source": "/es/", "destination": "/es/index.html" },
    { "source": "/zh/blog", "destination": "/zh/blog/index.html" },
    { "source": "/ja/blog", "destination": "/ja/blog/index.html" },
    { "source": "/ko/blog", "destination": "/ko/blog/index.html" },
    { "source": "/es/blog", "destination": "/es/blog/index.html" },
    { "source": "/zh/blog/", "destination": "/zh/blog/index.html" },
    { "source": "/ja/blog/", "destination": "/ja/blog/index.html" },
    { "source": "/ko/blog/", "destination": "/ko/blog/index.html" },
    { "source": "/es/blog/", "destination": "/es/blog/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https: http:; connect-src 'self' data: blob: https: http:; worker-src 'self' blob:; manifest-src 'self'"
        }
      ]
    },
    {
      "source": "/zh/(.*)",
      "headers": [{ "key": "Content-Language", "value": "zh" }]
    },
    {
      "source": "/ja/(.*)",
      "headers": [{ "key": "Content-Language", "value": "ja" }]
    },
    {
      "source": "/ko/(.*)",
      "headers": [{ "key": "Content-Language", "value": "ko" }]
    },
    {
      "source": "/es/(.*)",
      "headers": [{ "key": "Content-Language", "value": "es" }]
    }
  ]
}
